# Скопируйте этот файл в .env и заполните значения. Файл .env не попадает в git.

NODE_ENV=development
API_PORT=3000

# Токен бота от @BotFather. Без него сервер запустится, но бот работать не будет,
# а вход из Telegram будет отклоняться.
BOT_TOKEN=

# Адрес Mini App (HTTPS). Нужен для кнопки «Открыть Ognivo» в боте.
WEBAPP_URL=

# База данных. Для разработки — файл SQLite рядом со схемой.
DATABASE_URL="file:./dev.db"

# Только для локальной разработки в обычном браузере без Telegram:
# true — запросы без подписи Telegram выполняются от тестового пользователя.
# Работает только при NODE_ENV=development. На сервере всегда false.
DEV_AUTH_BYPASS=false
